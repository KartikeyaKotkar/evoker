{
  "name": "evoker",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "P3R-inspired UI component toolkit with an engine-independent motion core",
  "workspaces": [
    "core",
    "react",
    "playground"
  ],
  "scripts": {
    "build": "npm run build --workspace @k2x/evoker-core && npm run build --workspace @k2x/evoker && npm run build --workspace @evoker/playground",
    "test": "npm run test --workspace @k2x/evoker-core",
    "test:browser": "node scripts/browser-smoke.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:package": "npm run package && node scripts/package-check.mjs",
    "dev": "npm run dev --workspace @evoker/playground",
    "typecheck": "tsc -b --pretty false",
    "test:registry": "node scripts/package-check.mjs --registry"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K2X-Lab/evoker.git"
  },
  "bugs": {
    "url": "https://github.com/K2X-Lab/evoker/issues"
  },
  "homepage": "https://github.com/K2X-Lab/evoker#readme"
}
