{
  "name": "@kartikeyak/evoker-core",
  "version": "0.1.0-beta.1",
  "description": "Engine-independent timeline, motion, and interaction core",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('../LICENSE', 'dist/LICENSE')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KartikeyaKotkar/evoker.git",
    "directory": "core"
  },
  "bugs": {
    "url": "https://github.com/KartikeyaKotkar/evoker/issues"
  },
  "homepage": "https://github.com/KartikeyaKotkar/evoker#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  }
}
